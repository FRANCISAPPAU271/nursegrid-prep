+import { NextResponse } from "next/server";
+import { sql } from "drizzle-orm";
+import { db } from "@/db";
+import { getCurrentUser } from "@/lib/auth";
+import crypto from "node:crypto";
+
+export async function POST(request: Request, { params }: { params: Promise<{ id: string }> }) {
+  const user = await getCurrentUser();
+  if (!user) return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
+  const { id } = await params;
+  const body = await request.json().catch(() => ({}));
+  const action = String(body.action ?? "");
+  const group = await db.execute(sql`SELECT "owner_id" FROM "study_groups" WHERE "id" = ${id} LIMIT 1`);
+  const ownerId = (group.rows[0] as { owner_id?: string } | undefined)?.owner_id;
+  if (!ownerId) return NextResponse.json({ error: "Group not found." }, { status: 404 });
+
+  if (action === "leave") {
+    await db.execute(sql`DELETE FROM "study_group_members" WHERE "group_id" = ${id} AND "user_id" = ${user.id}`);
+    return NextResponse.json({ ok: true });
+  }
+  if (ownerId !== user.id) return NextResponse.json({ error: "Only the group owner can manage members." }, { status: 403 });
+  if (action === "remove") {
+    const memberId = String(body.userId ?? "");
+    if (memberId === ownerId) return NextResponse.json({ error: "The owner cannot be removed." }, { status: 400 });
+    await db.execute(sql`DELETE FROM "study_group_members" WHERE "group_id" = ${id} AND "user_id" = ${memberId}`);
+    return NextResponse.json({ ok: true });
+  }
+  if (action === "rotate") {
+    const code = crypto.randomBytes(4).toString("hex").toUpperCase();
+    await db.execute(sql`UPDATE "study_groups" SET "join_code" = ${code} WHERE "id" = ${id}`);
+    return NextResponse.json({ ok: true, joinCode: code });
+  }
+  return NextResponse.json({ error: "Unknown action." }, { status: 422 });
+}

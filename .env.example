# Copy this file to .env and fill in real values for local development.
# In Vercel, set these under Project → Settings → Environment Variables instead.

# PostgreSQL connection string.
# Local dev example:   postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Production (Neon):   postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Your deployed app's public URL (used for metadata, OG images, Capacitor config).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: enables real Visa card payments via Stripe Checkout.
# Leave unset to use the built-in demo card checkout instead.
STRIPE_SECRET_KEY=

# Optional: required only if you configure a Stripe webhook endpoint.
STRIPE_WEBHOOK_SECRET=

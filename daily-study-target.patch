@@ -0,0 +1,28 @@
+import Link from "next/link";
+
+export default function DailyTargetCard({ attemptedToday, target = 15 }: { attemptedToday: number; target?: number }) {
+  const progress = Math.min(100, Math.round((attemptedToday / target) * 100));
+  const remaining = Math.max(0, target - attemptedToday);
+  const complete = remaining === 0;
+
+  return (
+    <div className="overflow-hidden rounded-2xl border border-emerald-200 bg-gradient-to-br from-emerald-50 via-white to-teal-50 p-5">
+      <div className="flex items-start justify-between gap-3">
+        <div>
+          <p className="text-xs font-bold uppercase tracking-widest text-emerald-700">Today&apos;s study target</p>
+          <h2 className="mt-1 text-xl font-extrabold text-slate-950">{complete ? "Target complete 🎉" : `${remaining} question${remaining === 1 ? "" : "s"} to go`}</h2>
+          <p className="mt-1 text-sm text-slate-600">A focused daily habit beats last-minute cramming.</p>
+        </div>
+        <div className="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-emerald-600 text-center text-white shadow-lg shadow-emerald-600/20">
+          <span className="text-lg font-extrabold leading-none">{attemptedToday}</span>
+          <span className="text-[9px] font-bold uppercase">of {target}</span>
+        </div>
+      </div>
+      <div className="mt-4 h-2 overflow-hidden rounded-full bg-emerald-100"><div className="h-full rounded-full bg-emerald-600 transition-all" style={{ width: `${progress}%` }} /></div>
+      <div className="mt-4 flex items-center justify-between gap-3">
+        <span className="text-xs font-semibold text-emerald-800">{progress}% complete today</span>
+        <Link href="/dashboard/questions" className="rounded-xl bg-emerald-700 px-3 py-2 text-xs font-bold text-white hover:bg-emerald-800">Practice now →</Link>
+      </div>
+    </div>
+  );
+}
